{
	"name": "Zeropoint Agent",
	"dockerComposeFile": [
		"docker-compose.yml",
		"docker-compose.worktree.yml"
	],
	"service": "app",
	"workspaceFolder": "/workspaces/zeropoint-agent",
	"overrideCommand": false,
	"remoteUser": "vscode",
	"initializeCommand": "bash .devcontainer/init.sh",
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:2": {},
		"ghcr.io/nils-geistmann/devcontainers-features/create-remote-user:0": {
			"passwordLessSudo": true
		}
	},
	"customizations": {
		"vscode": {
			"settings": {
				"terminal.integrated.defaultProfile.linux": "bash"
			},
			"extensions": [
				"ms-python.python",
				"ms-python.debugpy",
				"qwtel.sqlite-viewer"
			]
		}
	},
	"postCreateCommand": "pip install -e .",
	"postStartCommand": "bash .devcontainer/postStartCommand.sh",
	"containerEnv": {
		"ZP_MODULE_STORAGE": "${containerWorkspaceFolder}/modules",
		"ZEROPOINT_MODE": "live"
	},
	"forwardPorts": [80, 443, 2370],
	"portsAttributes": {
		"80": {
			"label": "Envoy HTTP",
			"onAutoForward": "notify"
		},
		"443": {
			"label": "Envoy HTTPS",
			"onAutoForward": "notify"
		},
		"2370": {
			"label": "ZeroPoint Agent API",
			"onAutoForward": "notify"
		}
	}
}
