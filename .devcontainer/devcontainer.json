{
	"name": "Zeropoint Agent",
    "dockerFile": "../Dockerfile",
    "build": {
        "target": "develop"
    },
    "context": "..",
	"overrideCommand": true,
	"remoteUser": "vscode",
	"features": {
		"ghcr.io/devcontainers/features/node:1": {
			"version": "18.17.0"
		},
		"ghcr.io/devcontainers/features/docker-in-docker:2": {},
		"ghcr.io/nils-geistmann/devcontainers-features/create-remote-user:0": {
			"passwordLessSudo": true
		},
		"ghcr.io/schlich/devcontainer-features/playwright:0": {
			"browsers": "chromium"
		}
	},
	"customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash"
			},
			"extensions": [
				"ms-python.python",
				"zaaack.markdown-editor",
				"ms-python.debugpy",
				"idered.npm",
				"msjsdiag.debugger-for-chrome",
				"qwtel.sqlite-viewer"
			]
        }
    },
	"initializeCommand": "scripts/generate-defaults.sh ${localWorkspaceFolder}",
	"postCreateCommand": ". ${NVM_DIR}/nvm.sh && nvm install 18.17.0 && nvm use 18.17.0",
	"postAttachCommand": ". ${NVM_DIR}/nvm.sh && nvm use 18.17.0 && pip install -r requirements.txt && npm install --prefix webui",
	"containerEnv": {
		"ZP_MODULE_STORAGE": "/workspaces/zeropoint-agent/data/modules",
		"ZP_MARKER_DIR": "/workspaces/zeropoint-agent/data/markers"
	},
	"mounts": [
		"source=/dev,target=/dev,type=bind,consistency=consistent"
	],
	"runArgs": [
		"--gpus", "all"
	],
	"forwardPorts": [2370],
	"portsAttributes": {
		"2370": {
			"label": "ZeroPoint Agent API + WebUI",
			"onAutoForward": "notify"
		}
	}
}