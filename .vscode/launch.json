{
    "version": "0.2.0",
    "compounds": [
        {
            "name": "Zeropoint Agent + WebUI",
            "configurations": [
                "Zeropoint Agent",
                "WebUI"
            ],
            "stopAll": true
        }
    ],
    "configurations": [
        {
            "name": "Zeropoint Agent",
            "type": "debugpy",
            "request": "launch",
            "module": "zeropoint_agent",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "ZEROPOINT_ROOT_PATH": "${workspaceFolder}"
            },
            "preLaunchTask": "build-npm"
        },
        {
            "name": "Zeropoint Agent (no WebUI)",
            "type": "debugpy",
            "request": "launch",
            "module": "zeropoint_agent",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "ZEROPOINT_ROOT_PATH": "${workspaceFolder}"
            }
        },
        {
            "name": "WebUI",
            "type": "chrome",
            "request": "launch",
            "browserLaunchLocation": "ui",
            "runtimeExecutable": "stable",
            "url": "http://localhost:2370",
            "webRoot": "${workspaceFolder}/webui",
            "preLaunchTask": "waitForServer",
            "userDataDir": "${workspaceFolder}/.vscode/cache",
            "sourceMaps": true,
            "outFiles": [
                "${workspaceFolder}/webui/dist/**/*.js"
            ]
        }
    ]
}
