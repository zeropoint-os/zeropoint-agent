{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Zeropoint Agent (Live)",
            "type": "debugpy",
            "request": "launch",
            "module": "zeropoint_agent",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "PYTHONUNBUFFERED": "1",
                "ZEROPOINT_ROOT_PATH": "${workspaceFolder}",
                "ZEROPOINT_MODE": "live",
                "ZP_MODULE_STORAGE": "${workspaceFolder}/data/modules",
                "ZP_MARKER_DIR": "${workspaceFolder}/data/markers"
            },
            "preLaunchTask": "ensure-defaults-live",
            "args": [
                "serve"
            ]
        },
        {
            "name": "Zeropoint Agent (Mock)",
            "type": "debugpy",
            "request": "launch",
            "module": "zeropoint_agent",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "PYTHONUNBUFFERED": "1",
                "ZEROPOINT_ROOT_PATH": "${workspaceFolder}",
                "ZEROPOINT_MODE": "mock",
                "ZP_MODULE_STORAGE": "${workspaceFolder}/data/modules",
                "ZP_MARKER_DIR": "${workspaceFolder}/data/markers"
            },
            "preLaunchTask": "ensure-defaults-mock",
            "args": [
                "serve"
            ]
        }
    ]
}
